rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Exactly ONE Admin checked against protected system config document or designated email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kondareddy123@gmail.com' ||
        (
          exists(/databases/$(database)/documents/config/admin) &&
          (
            request.auth.uid == get(/databases/$(database)/documents/config/admin).data.adminUid ||
            request.auth.token.email == get(/databases/$(database)/documents/config/admin).data.adminEmail
          )
        )
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        request.auth.token.email == 'faculty456@gmail.com' ||
        exists(/databases/$(database)/documents/faculty/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty')
      );
    }

    function isAuthorizedCR() {
      return isSignedIn() && (
        request.auth.token.email == 'cr789@gmail.com' ||
        (
          exists(/databases/$(database)/documents/crs/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/crs/$(request.auth.uid)).data.canBook == true
        )
      );
    }

    function isRegisteredBookingUser() {
      return isAdmin() || isFaculty() || isAuthorizedCR();
    }

    // 1. Protected Admin Config Document (Read-only to authenticated users, NO user can write/overwrite)
    match /config/admin {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 2. Users Collection (users/{uid})
    // Users can NEVER edit or alter their own role! Admin can manage users.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid && !request.resource.data.keys().hasAny(['role']))
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // 3. CR Details Collection (crs/{crId}) - Exactly 5 sections, managed ONLY by Admin
    match /crs/{crId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Faculty Details Collection (faculty/{facultyId}) - Managed ONLY by Admin
    match /faculty/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Classrooms Collection (classrooms/{classroomId}) - Managed ONLY by Admin
    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Bookings Collection (bookings/{bookingId})
    match /bookings/{bookingId} {
      allow read: if isSignedIn();

      // Only registered Faculty and authorized CRs can create bookings
      allow create: if isSignedIn() &&
        isRegisteredBookingUser() &&
        request.resource.data.bookedBy == request.auth.uid &&
        request.resource.data.status == 'Confirmed' &&
        request.resource.data.startTime < request.resource.data.endTime;

      // Cancellation Rule: Users can cancel ONLY their own bookings. Admin can cancel any.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.bookedBy == request.auth.uid || resource.data.personId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason']) &&
          request.resource.data.status == 'Cancelled'
        )
      );

      // Deletion allowed only by Admin
      allow delete: if isAdmin();
    }

    // 7. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }
  }
}
